#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Extract test repos from git's own test suite (t/*.sh).
 *
 * Strategy: For each test script, extract the setup/initialization block
 * that creates the test repository. Run it to generate a repo. If it
 * produces a valid git repo, capture it as an oracle scenario.
 *
 * We focus on scripts that create interesting repo states (not scripts
 * that test git commands on existing repos).
 */

$root = dirname(__DIR__);
$gitTestDir = '/tmp/git-source/t';

if (!is_dir($gitTestDir)) {
    fwrite(STDERR, "Git test suite not found at {$gitTestDir}\n");
    exit(1);
}

$upstreamDir = $root . '/scenarios/upstream/git-test-suite';

if (!is_dir($upstreamDir)) {
    mkdir($upstreamDir, 0777, true);
}

// Scan test scripts and extract ones that create repos with interesting states
$scripts = glob($gitTestDir . '/t[0-9]*.sh');
$imported = 0;
$skipped = 0;
$failed = 0;
$maxScenarios = 200; // cap to keep manageable

foreach ($scripts as $scriptPath) {
    if ($imported >= $maxScenarios) {
        break;
    }

    $basename = basename($scriptPath, '.sh');
    $content = file_get_contents($scriptPath);

    if ($content === false) {
        continue;
    }

    // Skip very large/complex tests, interactive tests, and tests requiring special setup
    if (str_contains($content, 'lib-httpd') || str_contains($content, 'lib-git-daemon')
        || str_contains($content, 'lib-git-svn') || str_contains($content, 'lib-git-p4')
        || str_contains($content, 'lib-cvs') || str_contains($content, 'lib-gitweb')
        || str_contains($content, 'GIT_TEST_') || str_contains($content, 'test_external')
        || str_contains($content, 'lib-credential') || str_contains($content, 'lib-terminal')
        || str_contains($content, 'lib-perl')
    ) {
        $skipped++;
        continue;
    }

    $scenarioDir = $upstreamDir . '/' . $basename;

    if (is_dir($scenarioDir)) {
        continue;
    }

    // Build a setup script from the test's initialization:
    // Extract everything before the first test_expect block, plus the first
    // test_expect_success that creates commits.
    $setup = buildSetupScript($content, $basename);

    if ($setup === null) {
        $skipped++;
        continue;
    }

    // Try running it
    $tmpDir = sys_get_temp_dir() . '/git-suite-extract-' . bin2hex(random_bytes(4));
    mkdir($tmpDir, 0777, true);

    $cmd = sprintf(
        'cd %s && bash -e -c %s 2>&1',
        escapeshellarg($tmpDir),
        escapeshellarg($setup),
    );

    $output = [];
    exec($cmd, $output, $exitCode);

    // Check if a valid git repo was created
    $hasGit = is_dir($tmpDir . '/.git') && is_file($tmpDir . '/.git/HEAD');

    if (!$hasGit) {
        // Check subdirs
        foreach (scandir($tmpDir) as $entry) {
            if ($entry !== '.' && $entry !== '..' && is_dir($tmpDir . '/' . $entry . '/.git')) {
                // Move it up
                exec("mv " . escapeshellarg($tmpDir . '/' . $entry . '/.git') . " " . escapeshellarg($tmpDir . '/.git'));
                $hasGit = true;
                break;
            }
        }
    }

    // Check it has at least one object
    $objectCount = 0;

    if ($hasGit) {
        exec("cd " . escapeshellarg($tmpDir) . " && git rev-parse HEAD 2>/dev/null", $headOut, $headCode);
        $objectCount = $headCode === 0 ? 1 : 0;
    }

    exec('rm -rf ' . escapeshellarg($tmpDir));

    if (!$hasGit || $objectCount === 0) {
        $skipped++;
        continue;
    }

    // Valid repo produced — create scenario
    mkdir($scenarioDir, 0777, true);

    file_put_contents($scenarioDir . '/setup.sh', "#!/bin/bash\nset -e\n\n" . $setup . "\n");
    chmod($scenarioDir . '/setup.sh', 0755);

    file_put_contents($scenarioDir . '/scenario.json', json_encode([
        'name' => 'upstream/git-test-suite/' . $basename,
        'category' => 'upstream',
        'description' => "git t/: {$basename}",
        'operations' => [],
        'oracle_commands' => [],
        'expectations' => ['exact_match' => [], 'fsck_clean' => false],
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

    $imported++;
    fwrite(STDOUT, "  OK    {$basename}\n");
}

fwrite(STDOUT, "\nImported {$imported} scenarios, skipped {$skipped}\n");

/**
 * Extract a setup script from a git test file.
 */
function buildSetupScript(string $content, string $name): ?string
{
    $lines = explode("\n", $content);
    $setup = [];
    $inSetup = false;
    $depth = 0;
    $foundCommit = false;

    // Always start with git init and config
    $setup[] = 'git init .';
    $setup[] = 'git config user.email "test@test.com"';
    $setup[] = 'git config user.name "Test"';
    $setup[] = 'git config init.defaultBranch main';

    // Look for the first test_expect_success block that creates content
    foreach ($lines as $line) {
        $trimmed = trim($line);

        // Skip sourcing test-lib
        if (str_contains($trimmed, 'test-lib.sh') || str_contains($trimmed, 'test_description')) {
            continue;
        }

        // Look for setup blocks
        if (preg_match('/test_expect_success\s+.*(?:setup|init|creat|first|initial)/i', $trimmed)) {
            $inSetup = true;
            $depth = 0;
            continue;
        }

        if ($inSetup) {
            // Track quote depth
            if (str_contains($trimmed, "'")) {
                $depth += substr_count($trimmed, "'");
            }

            // Extract git commands
            if (preg_match('/^\s*(git\s+(?:add|commit|tag|branch|checkout|merge|mv|rm|config|update-ref|symbolic-ref|notes|stash)\b.*)/', $trimmed, $m)) {
                $cmd = $m[1];
                // Clean up test framework artifacts
                $cmd = str_replace('test_tick &&', '', $cmd);
                $cmd = str_replace('&&', '', $cmd);
                $cmd = trim($cmd);

                if ($cmd !== '') {
                    $setup[] = $cmd . ' 2>/dev/null || true';

                    if (str_contains($cmd, 'commit')) {
                        $foundCommit = true;
                    }
                }
            }

            // Extract file creation
            if (preg_match('/^\s*(echo\s+.+\s*>\s*.+)/', $trimmed, $m)) {
                $cmd = str_replace('&&', '', $m[1]);
                $setup[] = trim($cmd);
            }

            if (preg_match('/^\s*(printf\s+.+\s*>\s*.+)/', $trimmed, $m)) {
                $cmd = str_replace('&&', '', $m[1]);
                $setup[] = trim($cmd);
            }

            if (preg_match('/^\s*(mkdir\s+.+)/', $trimmed, $m)) {
                $cmd = str_replace('&&', '', $m[1]);
                $setup[] = trim($cmd);
            }

            if (preg_match('/^\s*(cat\s+>\s*.+)/', $trimmed, $m)) {
                $cmd = str_replace('&&', '', $m[1]);
                // Skip heredocs, too complex
            }

            // End of block
            if ($trimmed === "'" && $depth % 2 === 0) {
                $inSetup = false;

                if ($foundCommit) {
                    break;
                }
            }
        }
    }

    // If we didn't find any setup block, try a simpler approach:
    // just extract all git commands from the first 50 lines after test-lib
    if (!$foundCommit) {
        $setup = [
            'git init .',
            'git config user.email "test@test.com"',
            'git config user.name "Test"',
        ];

        $afterLib = false;
        $cmdCount = 0;

        foreach ($lines as $line) {
            if (str_contains($line, 'test-lib.sh')) {
                $afterLib = true;
                continue;
            }

            if (!$afterLib) {
                continue;
            }

            $trimmed = trim($line);

            // Extract echo/file creation
            if (preg_match('/^\s*(echo\s+[^|]+\s*>\s*\S+)/', $trimmed, $m)) {
                $setup[] = str_replace('&&', '', trim($m[1]));
                $cmdCount++;
            }

            // Extract git commands
            if (preg_match('/^\s*(git\s+(?:add|commit|tag|branch|checkout|merge)\b[^|]*)/', $trimmed, $m)) {
                $cmd = str_replace('&&', '', trim($m[1]));
                $setup[] = $cmd . ' 2>/dev/null || true';
                $cmdCount++;

                if (str_contains($cmd, 'commit')) {
                    $foundCommit = true;
                }
            }

            if ($cmdCount > 15 || ($foundCommit && $cmdCount > 5)) {
                break;
            }
        }
    }

    if (!$foundCommit) {
        return null;
    }

    return implode("\n", $setup);
}
