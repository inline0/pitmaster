{
    "name": "open-issue-regressions",
    "category": "repository",
    "description": "Git-backed checks for persisted reflogs, sparse path history, already-merged branches, v4 index writes, multiple stashes, linked handles and hook configuration",
    "operations": [
        "regression_log",
        "regression_merge",
        "regression_index",
        "regression_stash",
        "regression_linked",
        "regression_hooks",
        "regression_rerere",
        "regression_init"
    ],
    "oracle_commands": {
        "regression_log": "php \"{{SCENARIO_DIR}}/check.php\" git log",
        "regression_merge": "php \"{{SCENARIO_DIR}}/check.php\" git merge",
        "regression_index": "php \"{{SCENARIO_DIR}}/check.php\" git index",
        "regression_stash": "php \"{{SCENARIO_DIR}}/check.php\" git stash",
        "regression_linked": "php \"{{SCENARIO_DIR}}/check.php\" git linked",
        "regression_hooks": "php \"{{SCENARIO_DIR}}/check.php\" git hooks",
        "regression_rerere": "php \"{{SCENARIO_DIR}}/check.php\" git rerere",
        "regression_init": "php \"{{SCENARIO_DIR}}/check.php\" git init"
    },
    "actual_commands": {
        "regression_log": "php \"{{SCENARIO_DIR}}/check.php\" pitmaster log",
        "regression_merge": "php \"{{SCENARIO_DIR}}/check.php\" pitmaster merge",
        "regression_index": "php \"{{SCENARIO_DIR}}/check.php\" pitmaster index",
        "regression_stash": "php \"{{SCENARIO_DIR}}/check.php\" pitmaster stash",
        "regression_linked": "php \"{{SCENARIO_DIR}}/check.php\" pitmaster linked",
        "regression_hooks": "php \"{{SCENARIO_DIR}}/check.php\" pitmaster hooks",
        "regression_rerere": "php \"{{SCENARIO_DIR}}/check.php\" pitmaster rerere",
        "regression_init": "php \"{{SCENARIO_DIR}}/check.php\" pitmaster init"
    },
    "expectations": {
        "runtime_exact_match": [
            "regression_log",
            "regression_merge",
            "regression_index",
            "regression_stash",
            "regression_linked",
            "regression_hooks",
            "regression_rerere",
            "regression_init"
        ],
        "fsck_clean": false
    }
}
