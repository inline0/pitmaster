{
    "name": "bundle-roundtrip",
    "category": "advanced",
    "description": "Compare bundle verification output after a Pitmaster parse/write roundtrip",
    "operations": [
        "bundle"
    ],
    "oracle_commands": {
        "bundle": "bash \"{{SCENARIO_DIR}}/oracle-bundle.sh\""
    },
    "actual_commands": {
        "bundle": "php \"{{SCENARIO_DIR}}/actual-bundle.php\" && git bundle verify source.bundle"
    },
    "expectations": {
        "exact_match": [
            "objects",
            "refs",
            "log",
            "fsck"
        ],
        "exact_meta_match": [
            "bundle"
        ],
        "fsck_clean": true
    }
}
