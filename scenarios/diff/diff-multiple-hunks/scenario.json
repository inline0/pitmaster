{
    "name": "diff-multiple-hunks",
    "category": "diff",
    "description": "Diff with changes in two separate regions producing multiple hunks",
    "operations": ["diff"],
    "oracle_commands": {
        "diff": "git -c color.ui=never diff"
    },
    "actual_commands": {
        "diff": "php \"{{ROOT}}/bin/pitmaster\" diff | perl -pe 's/\\e\\[[0-9;]*m//g'"
    },
    "expectations": {
        "exact_match": ["diff"],
        "fsck_clean": true
    }
}
