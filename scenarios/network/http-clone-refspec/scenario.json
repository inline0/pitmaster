{
    "name": "http-clone-refspec",
    "category": "network",
    "description": "Compare HTTP clone tracking config and single-branch fetch refspec behavior against Git",
    "operations": [
        "clone_refspec_state"
    ],
    "oracle_commands": {
        "clone_refspec_state": "cat .clone-refspec-state"
    },
    "actual_commands": {
        "clone_refspec_state": "cat .clone-refspec-state"
    },
    "expectations": {
        "exact_match": [
            "objects",
            "refs",
            "log",
            "clone_refspec_state"
        ],
        "runtime_exact_match": [
            "fsck"
        ],
        "fsck_clean": false
    }
}
