{
    "name": "cherry-pick-conflict-continue",
    "category": "cherry-pick",
    "description": "Resolve a cherry-pick conflict and continue via the Pitmaster CLI",
    "operations": [
        "status",
        "head_ref",
        "subjects",
        "parents",
        "tree",
        "worktree",
        "head_reflog",
        "branch_reflog"
    ],
    "oracle_commands": {
        "status": "git status --porcelain=v2",
        "head_ref": "cat .git/HEAD",
        "subjects": "git log --format='%s|%an <%ae>|%cn <%ce>' --reverse --all",
        "parents": "git show -s --format=%P HEAD",
        "tree": "git show -s --format=%T HEAD",
        "worktree": "cat a.txt",
        "head_reflog": "git reflog --format=%gs -n 1",
        "branch_reflog": "git reflog show refs/heads/main --format=%gs -n 1"
    },
    "actual_commands": {
        "status": "git status --porcelain=v2",
        "head_ref": "cat .git/HEAD",
        "subjects": "git log --format='%s|%an <%ae>|%cn <%ce>' --reverse --all",
        "parents": "git show -s --format=%P HEAD",
        "tree": "git show -s --format=%T HEAD",
        "worktree": "cat a.txt",
        "head_reflog": "git reflog --format=%gs -n 1",
        "branch_reflog": "git reflog show refs/heads/main --format=%gs -n 1"
    },
    "expectations": {
        "exact_match": [
            "objects",
            "refs",
            "log",
            "status",
            "head_ref",
            "subjects",
            "parents",
            "tree",
            "worktree",
            "head_reflog",
            "branch_reflog"
        ],
        "fsck_clean": false
    }
}
