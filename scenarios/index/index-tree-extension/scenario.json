{
    "name": "index-tree-extension",
    "category": "index",
    "description": "Round-trip a Git-generated TREE index extension without changing the TREE payload or Git-visible state",
    "operations": [
        "tree_extension_hex",
        "status",
        "ls_files_stage"
    ],
    "oracle_commands": {
        "tree_extension_hex": "php {{ROOT}}/tests/Fixtures/index_extension_hex.php .git/index TREE",
        "status": "git status --porcelain=v2",
        "ls_files_stage": "git ls-files --stage"
    },
    "actual_commands": {
        "tree_extension_hex": "php {{ROOT}}/tests/Fixtures/index_extension_hex.php .git/index TREE",
        "status": "git status --porcelain=v2",
        "ls_files_stage": "git ls-files --stage"
    },
    "expectations": {
        "exact_match": [
            "objects",
            "refs",
            "log",
            "fsck",
            "tree_extension_hex",
            "status",
            "ls_files_stage"
        ],
        "fsck_clean": true
    }
}
