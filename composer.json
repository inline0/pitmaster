{
    "name": "inline0/pitmaster",
    "description": "Pure PHP Git implementation with oracle-driven testing against canonical git.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Pitmaster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pitmaster\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:unit": "phpunit --testsuite unit",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "analyse": "phpstan analyse"
    },
    "bin": [
        "bin/pitmaster",
        "bin/oracle",
        "bin/actual",
        "bin/compare",
        "bin/test-scenario",
        "bin/test-regression",
        "bin/verify-compliance"
    ]
}
